{
  "manifest_version": 3,
  "name": "YT Local Downloader",
  "version": "1.0.0",
  "description": "Download YouTube videos in high quality via a local companion server (yt-dlp + ffmpeg). Personal sideloaded use only.",
  "minimum_chrome_version": "109",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT Local Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": ["common/api.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "notifications", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-local-downloader@example.local",
      "strict_min_version": "109.0"
    }
  }
}
